# TikTok @username to watch (without @)
TIKTOK_USERNAME=your_username
# URL of the folder that serves web/ (index.php + api/)
SOCIOBEAST_URL=https://virlabdesign.com/sociobeast
# Must match bridge_secret in web/api/config.local.php
BRIDGE_SECRET=change_me
# Batch flush interval (ms) — events are grouped to limit HTTP calls
FLUSH_MS=800
# Optional: TikTok session id if the connector needs auth (see tiktok-live-connector docs)
# TIKTOK_SESSION_ID=
